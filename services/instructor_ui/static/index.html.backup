<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Интерфейс инструктора</title>
<!-- Иконка встроена: тренажёр работает в изолированном контуре, внешних запросов быть не должно. -->
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%2310131a'/%3E%3Ccircle cx='16' cy='11' r='5' fill='%2335c46a'/%3E%3Crect x='14' y='17' width='4' height='11' rx='1' fill='%234a9eff'/%3E%3C/svg%3E">
<style>
  /* Оформление намеренно плоское: тонкие линии и воздух вместо вложенных
     карточек со скруглениями. Экран инструктора — рабочий инструмент,
     а не витрина, и лишние рамки только дробят внимание. */
  :root {
    /* Выпадающий список рисует браузер, а не мы: без этой строки он
       раскрывается светлым и светлый же текст в нём пропадает. */
    color-scheme: dark;
    --bg: #0f1216;
    --panel: #151a20;
    --line: #232a33;
    --line-soft: #1c232b;
    --text: #e7eaef;
    --muted: #7f8896;
    --accent: #4a9eff;
    --ok: #3fbf6f;
    --warn: #d99a2b;
    --crit: #e8544c;
    --unclear: #8b7de0;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font: 14px/1.55 "Segoe UI", system-ui, sans-serif;
  }

  /* --- шапка --- */
  header {
    display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap;
    padding: 16px 24px 14px; border-bottom: 1px solid var(--line);
  }
  header h1 { margin: 0; font-size: 17px; font-weight: 600; letter-spacing: -.01em; }
  header .code {
    font-family: ui-monospace, monospace; font-size: 12px; color: var(--accent);
    letter-spacing: .06em;
  }
  header .spacer { flex: 1; }
  .badge { font-size: 12px; color: var(--muted); }
  .badge.running { color: var(--ok); }
  .badge.finished { color: var(--accent); }
  .badge.aborted { color: var(--crit); }

  /* --- панель управления --- */
  .controls {
    display: flex; gap: 8px; align-items: center; flex-wrap: wrap;
    padding: 12px 24px; border-bottom: 1px solid var(--line);
  }
  .controls label { display: inline-flex; align-items: center; gap: 8px; min-width: 0;
                    font-size: 12px; color: var(--muted); }
  select, input[type=text] {
    background: var(--panel); color: var(--text); border: 1px solid var(--line);
    border-radius: 2px; padding: 6px 9px; font: inherit; font-size: 13px; max-width: 100%;
  }
  select:focus, input:focus { outline: none; border-color: var(--accent); }
  select option { background: var(--panel); color: var(--text); }
  button {
    background: transparent; color: var(--text); border: 1px solid var(--line);
    border-radius: 2px; padding: 6px 13px; font: inherit; font-size: 13px; cursor: pointer;
  }
  button:hover:not(:disabled) { border-color: var(--muted); }
  button:disabled { opacity: .35; cursor: default; }
  button.primary { border-color: var(--accent); color: var(--accent); }
  button.danger { border-color: rgba(232,84,76,.5); color: var(--crit); }
  button.active { border-color: var(--accent); color: var(--accent); }

  /* --- раскладка --- */
  main {
    display: grid; gap: 0 32px; padding: 0 24px 28px; align-items: start;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  @media (max-width: 1000px) { main { grid-template-columns: minmax(0, 1fr); } }

  section { padding: 20px 0 4px; min-width: 0; }
  section > h2 {
    margin: 0 0 12px; font-size: 11px; font-weight: 600;
    letter-spacing: .08em; text-transform: uppercase; color: var(--muted);
  }
  h3.sub {
    margin: 22px 0 8px; font-size: 11px; text-transform: uppercase;
    letter-spacing: .08em; color: var(--muted); font-weight: 600;
  }

  /* --- кадр --- */
  /* Место под кадр занято сразу: до загрузки ролика у video нет размеров,
     и без заданных пропорций блок сначала схлопывался в полоску, а потом
     раздвигал соседей. Подложка заодно очерчивает границы кадра на тёмном
     фоне — у съёмки бывают тёмные края. */
  .pane-video { padding-top: 20px; }
  /* Высота задана, а не выведена из ролика: съёмка с нагрудной камеры
     вертикальная, и по её пропорциям кадр занял бы страницу целиком.
     Та же высота, что у журнала, — они делят страницу поровну. */
  .player {
    background: var(--panel); height: clamp(260px, 62vh, 720px);
    display: flex; align-items: center; justify-content: center;
  }
  .player video { max-width: 100%; max-height: 100%; display: block; }

  /* Когда картинки нет, то же окно занимает разбор потока. У налива камеры
     нет вовсе, и пустая рамка вместо неё выглядела бы поломкой. */
  .player .feed {
    width: 100%; height: 100%; overflow-y: auto; align-self: stretch;
    font-family: ui-monospace, "Cascadia Mono", monospace; font-size: 12px;
    scrollbar-width: thin; scrollbar-color: var(--line) transparent;
  }
  .player .feed::-webkit-scrollbar { width: 6px; }
  .player .feed::-webkit-scrollbar-track { background: transparent; }
  .player .feed::-webkit-scrollbar-thumb { background: var(--line); border-radius: 3px; }
  .feed .row {
    display: grid; grid-template-columns: 96px minmax(0, 1fr) minmax(0, 1.1fr) 46px 92px;
    gap: 10px;
    padding: 5px 14px; border-bottom: 1px solid var(--line-soft); white-space: nowrap;
  }
  .feed .t { color: var(--muted); }
  /* Длинные названия положений («опущена до упора крышки в горловину»)
     обрезаются, а не наезжают на соседнюю колонку. */
  .feed .var, .feed .val { overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .feed .val { color: var(--ok); }
  .feed .conf { color: var(--muted); text-align: right; }
  .feed .status { font-size: 11px; color: var(--muted); }
  .feed .row.unclear .val { color: var(--unclear); }
  /* Смена состояния — то, ради чего лента и нужна: её видно среди
     десятков сырых наблюдений в секунду. */
  .feed .row.confirmed { border-left: 2px solid var(--accent); padding-left: 12px; }
  .feed .row.confirmed .val { color: var(--accent); }
  .feed .row.lost { border-left: 2px solid var(--crit); padding-left: 12px; }
  .feed .row.lost .val, .feed .row.lost .status { color: var(--crit); }
  .feed .empty {
    padding: 16px; color: var(--muted); font-family: inherit; font-size: 13px;
  }

  /* --- шаги --- */
  .step {
    display: grid; grid-template-columns: 22px 1fr; gap: 12px;
    padding: 11px 0; border-top: 1px solid var(--line-soft); align-items: start;
  }
  .step:first-child { border-top: none; }
  .step .num {
    width: 20px; height: 20px; display: grid; place-items: center; margin-top: 1px;
    font-size: 11px; font-weight: 600; color: var(--muted);
    border: 1px solid var(--line); border-radius: 50%;
  }
  .step.active .num { color: var(--accent); border-color: var(--accent); }
  .step.done .num { color: var(--ok); border-color: rgba(63,191,111,.5); }
  .step.failed .num { color: var(--crit); border-color: rgba(232,84,76,.5); }
  .step .title { font-size: 13px; }
  .step.done .title { color: var(--muted); }
  .step .crit {
    font-size: 10px; color: var(--crit); margin-left: 7px; letter-spacing: .05em;
  }
  .step .meta { font-size: 11px; color: var(--muted); margin-top: 3px; }

  /* --- журнал --- */
  #journal {
    max-height: clamp(260px, 62vh, 720px); overflow-y: auto;
    scrollbar-width: thin; scrollbar-color: var(--line) transparent;
  }
  #journal::-webkit-scrollbar { width: 6px; }
  #journal::-webkit-scrollbar-track { background: transparent; }
  #journal::-webkit-scrollbar-thumb { background: var(--line); border-radius: 3px; }
  #journal::-webkit-scrollbar-thumb:hover { background: var(--muted); }
  .entry {
    padding: 10px 0 10px 12px; border-top: 1px solid var(--line-soft);
    border-left: 2px solid transparent; font-size: 13px;
  }
  .entry:first-child { border-top: none; }
  .entry .row { display: flex; gap: 10px; align-items: baseline; }
  .entry .time {
    color: var(--muted); font-family: ui-monospace, monospace; font-size: 11px;
  }
  .entry .text { margin-top: 2px; }
  /* Вид оценки передаётся цветом строки, а не плашкой рядом с ней. */
  .entry.MATCH { border-left-color: rgba(63,191,111,.55); }
  .entry.MISMATCH { border-left-color: var(--crit); }
  .entry.UNCLEAR { border-left-color: rgba(139,125,224,.6); }
  .entry.TIMEOUT { border-left-color: rgba(217,154,43,.6); }
  .entry.voice .text { color: var(--muted); }
  .entry.critical .text { color: #ffd2d0; }

  .alert {
    margin: 0 0 14px; padding: 11px 13px; font-size: 13px;
    border-left: 2px solid var(--crit); background: rgba(232,84,76,.08); color: #ffd2d0;
  }

  /* --- списки --- */
  /* Записи — карточки на подложке: они кликабельны, и заливка отличает их
     от строк журнала, которые читают, но не нажимают. */
  .runs { display: flex; flex-direction: column; gap: 2px; }
  .runs button {
    text-align: left; padding: 12px 13px; font-size: 13px; line-height: 1.45;
    border: none; border-left: 2px solid transparent; border-radius: 0;
    background: var(--panel);
  }
  .runs button:hover:not(:disabled) {
    color: var(--accent); border-left-color: var(--accent);
  }
  .runs button .d { display: block; color: var(--muted); font-size: 11px; margin-top: 3px; }

  .switches { display: flex; flex-wrap: wrap; gap: 6px; }
  .switches button { padding: 5px 11px; font-size: 12px; }
  .mic { margin-top: 10px; display: flex; flex-direction: column; gap: 6px; }
  .mic button { align-self: flex-start; padding: 5px 11px; font-size: 12px; }
  .mic-level { height: 4px; background: var(--line-soft); border-radius: 2px; overflow: hidden; }
  .mic-level > div { height: 100%; width: 0; background: var(--ok); transition: width 80ms linear; }
  .mic-status { font-size: 12px; color: var(--muted); min-height: 16px; }
  .mic-status.error { color: var(--crit); }
  .mic-heard { font-size: 12px; color: var(--text); min-height: 16px; }

  /* --- узкий экран --- */
  @media (max-width: 820px) {
    header, .controls { padding-left: 14px; padding-right: 14px; }
    main { padding: 0 14px 22px; }
    header h1 { font-size: 15px; flex-basis: 100%; order: 3; }
    header .spacer { display: none; }
    header .badge { margin-left: auto; }
    .controls .spacer { display: none; }
    .controls label { flex: 1 1 100%; }
    .controls label select { flex: 1; min-width: 0; }
    #trainee { flex: 1 1 150px; min-width: 0; }
    .controls button { flex: 0 0 auto; }
  }
</style>
</head>
<body>

<header>
  <span class="code" id="scenario-code"></span>
  <h1 id="scenario-title">Загрузка сценария…</h1>
  <div class="spacer"></div>
  <span class="badge" id="state-badge">не запущен</span>
</header>

<div class="controls">
  <label>Сюжет
    <select id="scenario-pick"></select>
  </label>
  <input type="text" id="trainee" placeholder="ФИО обучаемого" size="26">
  <button class="primary" id="btn-start">Старт</button>
  <button id="btn-pause">Пауза</button>
  <button class="danger" id="btn-stop">Стоп</button>
  <button id="btn-reset">Сброс</button>
  <div class="spacer"></div>
  <button id="btn-report">Отчёт</button>
  <button id="btn-panel">Пульт</button>
  <button id="btn-mute">Звук: вкл</button>
</div>

<main>
  <section class="pane-video" id="pane-video">
    <div class="body">
      <div class="player" id="player">
        <video id="video" muted playsinline preload="auto" style="display:none"></video>
        <div class="feed" id="feed"><div class="empty">Наблюдений пока нет</div></div>
      </div>
    </div>
  </section>

  <section class="pane-journal">
    <h2>Журнал распознанных действий</h2>
    <div id="blocked"></div>
    <div id="journal"></div>
  </section>

  <section class="pane-steps">
    <h2>Последовательность СОП</h2>
    <div id="steps"></div>
  </section>

  <section class="pane-side">
    <div class="body">
      <div class="runs" id="runs"></div>
      <div id="cv-logs-wrap" style="display:none">
        <div class="runs" id="cv-logs"></div>
      </div>

      <h3 class="sub">Реплика обучаемого</h3>
      <div class="switches">
        <button data-voice="ready_report">Доклад о готовности</button>
        <button data-voice="repeat">Повтори</button>
        <button data-voice="help">Помощь</button>
      </div>
      <div class="mic">
        <div class="switches">
          <button id="btn-mic" disabled>Микрофон: выкл</button>
          <button id="btn-mic-test" disabled>Проверить голос</button>
        </div>
        <div class="mic-level"><div id="mic-level"></div></div>
        <div class="mic-status" id="mic-status">проверяю распознавание речи…</div>
        <div class="mic-heard" id="mic-heard"></div>
      </div>
    </div>
  </section>
</main>

<script>
const $ = (id) => document.getElementById(id);
const DEMO_MODE = 'demo';
let lastEntryText = null;
let scenario = null, snapshot = null, muted = false, browserSpeech = true;
let currentSession = null;

const fmtTime = (iso) => new Date(iso).toLocaleTimeString('ru-RU', {hour12: false});

async function api(path, options) {
  const response = await fetch(path, options);
  if (response.status === 409) {
    // Занятие потеряно: стенд перезапустили или вкладка провисела дольше
    // суток. Ключ занятия выдаёт страница, поэтому достаточно перезагрузиться.
    reloadOnce();
    throw new Error(`${path}: занятие не найдено`);
  }
  if (!response.ok) throw new Error(`${path}: ${response.status}`);
  const type = response.headers.get('content-type') || '';
  return type.includes('json') ? response.json() : response.text();
}

let reloading = false;
function reloadOnce() {
  if (reloading) return;
  reloading = true;
  location.reload();
}
const post = (path, body) => api(path, {
  method: 'POST',
  headers: {'Content-Type': 'application/json'},
  body: JSON.stringify(body || {}),
});

/* ---------- сценарий ---------- */
async function loadScenario() {
  scenario = await api('/scenario');
  $('scenario-code').textContent = scenario.scenario_code;
  $('scenario-title').textContent = scenario.title;
  renderSteps();
}

function renderSteps() {
  const byId = {};
  (snapshot?.steps || []).forEach(s => byId[s.id] = s);
  $('steps').innerHTML = scenario.steps.map(step => {
    const live = byId[step.id] || {status: 'pending'};
    const critical = step.critical ? '<span class="crit">КРИТ</span>' : '';
    const requires = step.requires.length
      ? `требует: ${step.requires.map(r => scenario.steps.find(s => s.id === r).index).join(', ')}`
      : 'без предусловий';
    return `<div class="step ${live.status}">
      <div class="num">${step.index}</div>
      <div>
        <div class="title">${step.title}${critical}</div>
        <div class="meta">${requires} · ${step.expect.join(', ')}</div>
      </div>
    </div>`;
  }).join('');
}



async function loadRuns() {
  const runs = await api('/emulator/runs');
  $('runs').innerHTML = runs.map(run =>
    `<button data-run="${run.id}">${run.title}
       <span class="d">${run.description || ''} · ${run.duration_sec} с</span></button>`).join('');
  $('runs').querySelectorAll('button').forEach(button => {
    button.onclick = async () => {
      await post('/session/reset');
      await post('/session/start', {
        mode: DEMO_MODE,
        trainee_name: $('trainee').value || `Прогон «${button.textContent.trim().split('\n')[0]}»`,
      });
      await post(`/emulator/runs/${button.dataset.run}/start`);
    };
  });
}

/* ---------- журнал ---------- */
function addEntry(html, critical, kind) {
  const div = document.createElement('div');
  div.className = 'entry' + (kind ? ' ' + kind : '') + (critical ? ' critical' : '');
  div.innerHTML = html;
  $('journal').prepend(div);
  while ($('journal').children.length > 200) $('journal').lastChild.remove();
}

function onVerdict(v) {
  lastEntryText = v.message;
  // Вид оценки читается по цвету полосы слева: плашка рядом с текстом
  // повторяла бы то, что и так сказано в самой формулировке.
  addEntry(`
    <div class="row"><span class="time">${fmtTime(v.ts)}</span></div>
    <div class="text">${v.message}</div>`,
    v.severity === 'critical', v.kind);
}

function onSpoken(event, replay) {
  // Реплика дословно повторяет только что записанный вердикт — в журнале это
  // одна и та же строка дважды подряд. Озвучиваем, но не дублируем на экране.
  if (event.text !== lastEntryText) {
    addEntry(`
      <div class="row"><span class="time">${fmtTime(event.ts)}</span></div>
      <div class="text">${event.text}</div>`, false, 'voice');
    lastEntryText = event.text;
  }
  if (!replay) speak(event);
}

/* ---------- голос ---------- */
// Реплики звучат строго по одной. Сервер разводит их по времени, но сеть
// может доставить два события подряд, а перерисовка страницы — целую пачку.
// Без очереди они зазвучали бы хором.
let audioQueue = [], audioCurrent = null;

function playNext() {
  const url = audioQueue.shift();
  if (!url) { audioCurrent = null; return; }
  audioCurrent = new Audio(url);
  audioCurrent.onended = playNext;
  audioCurrent.onerror = playNext;
  audioCurrent.play().catch(playNext);
}

function stopSpeaking() {
  audioQueue = [];
  if (audioCurrent) { audioCurrent.pause(); audioCurrent = null; }
  speechSynthesis.cancel();
}

function speak(event) {
  if (muted) return;
  // Критическая реплика обрывает предыдущую: предупреждение об опасности не
  // может ждать, пока договорит подтверждение прошлого шага.
  const interrupt = event.kind === 'critical' || event.interrupted;
  if (event.engine === 'browser') {
    if (interrupt) speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(event.text);
    utterance.lang = 'ru-RU';
    speechSynthesis.speak(utterance);
  } else {
    if (interrupt) stopSpeaking();
    audioQueue.push(`/voice/audio/${event.request_id}.wav`);
    if (!audioCurrent) playNext();
  }
}

/* ---------- голос обучаемого ---------- */
// Микрофон слушает всё занятие. Речь от тишины страница отделяет сама, по
// уровню сигнала, и отправляет стенду фразу целиком: тот распознаёт её и
// выделяет команду тем же разбором ключевых слов, что стоит за кнопками.
//
// Пока говорит стенд, микрофон глух. Его инструкция звучит «…доложите о
// готовности к работе», и без этого стенд услышал бы сам себя и засчитал
// доклад. После реплики ещё выжидаем хвост: у динамика и комнаты есть эхо.
const MIC = {
  rate: 16000,       // Whisper слушает 16 кГц, больше отправлять незачем
  startMs: 150,      // столько подряд громче порога — фраза началась
  silenceMs: 700,    // столько тишины — фраза кончилась
  minMs: 350,        // короче — щелчок или стук, а не слово
  maxMs: 6000,       // длиннее команд не бывает, дальше режем
  prerollMs: 300,    // начало слова приходится на нарастание громкости
  tailMs: 800,       // эхо после реплики стенда
  floor: 0.012,      // ниже этого речи не бывает даже в тихой комнате
};
const INTENT_TITLES = {ready_report: 'доклад о готовности', repeat: 'повтори', help: 'помощь'};

// Режим микрофона: null — выключен, 'live' — команды идут в занятие,
// 'test' — проверка: слушает и без занятия, но в сценарий ничего не отправляет.
let micMode = null, micRig = null, micBusy = false;
let standSpokeAt = -Infinity, micHoldUntil = 0;

function standSpeaking() {
  return Boolean(audioCurrent) || audioQueue.length > 0 || speechSynthesis.speaking;
}

function micStatus(text, kind, holdMs) {
  if (micMode === 'test' && !kind) text = 'проверка: ' + text;
  const el = $('mic-status');
  const cls = 'mic-status' + (kind ? ' ' + kind : '');
  if (el.textContent !== text) el.textContent = text;
  if (el.className !== cls) el.className = cls;
  micHoldUntil = holdMs ? performance.now() + holdMs : 0;
}

function setupMic(serverStt) {
  const button = $('btn-mic');
  if (!serverStt) {
    micStatus('распознавание речи на стенде не настроено — нужен HF_TOKEN');
    return;
  }
  if (!navigator.mediaDevices) {
    // Браузер даёт микрофон только защищённой странице, а по http такой
    // считается лишь 127.0.0.1. Стенд, открытый по сетевому адресу, не услышит.
    micStatus('микрофон доступен только на самом стенде, по адресу 127.0.0.1');
    return;
  }
  button.disabled = false;
  $('btn-mic-test').disabled = false;
  micStatus('выключен');
}

async function startMic() {
  const stream = await navigator.mediaDevices.getUserMedia({
    audio: {echoCancellation: true, noiseSuppression: true, autoGainControl: true},
  });
  const ctx = new AudioContext();
  const source = ctx.createMediaStreamSource(stream);
  // ScriptProcessor устарел, но работает везде и не требует отдельного файла
  // под AudioWorklet; для фраз в несколько секунд его хватает с запасом.
  const node = ctx.createScriptProcessor(4096, 1, 1);
  const rig = {stream, ctx, node, noise: MIC.floor, state: 'idle',
               loud: 0, quiet: 0, preroll: [], chunks: [], length: 0};
  node.onaudioprocess = (e) => onMicBlock(rig, e.inputBuffer.getChannelData(0));
  source.connect(node);
  node.connect(ctx.destination);  // иначе Chrome не зовёт обработчик; выход пустой
  return rig;
}

function stopMic() {
  if (!micRig) return;
  micRig.node.disconnect();
  micRig.stream.getTracks().forEach(track => track.stop());
  micRig.ctx.close();
  micRig = null;
  $('mic-level').style.width = '0';
}

function resetMic(rig) {
  rig.state = 'idle';
  rig.loud = 0;
  rig.quiet = 0;
  rig.chunks = [];
  rig.length = 0;
}

function onMicBlock(rig, samples) {
  const block = new Float32Array(samples);  // браузер переиспользует свой буфер
  const rate = rig.ctx.sampleRate;
  const ms = block.length / rate * 1000;
  let sum = 0;
  for (let i = 0; i < block.length; i++) sum += block[i] * block[i];
  const level = Math.sqrt(sum / block.length);
  $('mic-level').style.width = Math.min(100, level * 400) + '%';

  const now = performance.now();
  if (standSpeaking()) standSpokeAt = now;
  const live = micMode === 'test' || (Boolean(snapshot) && snapshot.state === 'running');
  const echo = now - standSpokeAt < MIC.tailMs;

  if (!live || echo || micBusy) {
    if (rig.state === 'speech' && echo) micStatus('стенд заговорил — фраза отброшена', null, 1500);
    resetMic(rig);
    if (!micBusy && now >= micHoldUntil) {
      micStatus(live ? 'говорит стенд — микрофон молчит' : 'занятие не идёт');
    }
    return;
  }

  const loud = level > Math.max(MIC.floor, rig.noise * 3);

  if (rig.state === 'idle') {
    // Уровень тишины подстраивается под комнату, пока никто не говорит.
    if (!loud) rig.noise = rig.noise * 0.95 + level * 0.05;
    rig.preroll.push(block);
    while (rig.preroll.length * ms > MIC.prerollMs) rig.preroll.shift();
    rig.loud = loud ? rig.loud + ms : 0;
    if (rig.loud >= MIC.startMs) {
      rig.state = 'speech';
      rig.chunks = [...rig.preroll];
      rig.length = rig.chunks.reduce((n, chunk) => n + chunk.length, 0);
      rig.quiet = 0;
      micStatus('слышу речь…');
    } else if (now >= micHoldUntil) {
      micStatus('слушаю');
    }
    return;
  }

  rig.chunks.push(block);
  rig.length += block.length;
  rig.quiet = loud ? 0 : rig.quiet + ms;
  const durationMs = rig.length / rate * 1000;
  if (rig.quiet >= MIC.silenceMs || durationMs >= MIC.maxMs) {
    const chunks = rig.chunks;
    const speechMs = durationMs - rig.quiet;
    resetMic(rig);
    if (speechMs >= MIC.minMs) sendPhrase(chunks, rate);
  }
}

function toWav(chunks, rate) {
  const total = chunks.reduce((n, chunk) => n + chunk.length, 0);
  const merged = new Float32Array(total);
  let offset = 0;
  for (const chunk of chunks) { merged.set(chunk, offset); offset += chunk.length; }

  // Понижение частоты усреднением по окну — заодно и фильтр от наложения частот.
  const ratio = rate / MIC.rate;
  const length = Math.floor(total / ratio);
  const pcm = new Int16Array(length);
  for (let i = 0; i < length; i++) {
    const from = Math.floor(i * ratio);
    const to = Math.min(total, Math.floor((i + 1) * ratio));
    let acc = 0;
    for (let j = from; j < to; j++) acc += merged[j];
    const value = acc / Math.max(1, to - from);
    pcm[i] = Math.max(-1, Math.min(1, value)) * 0x7fff;
  }

  const buffer = new ArrayBuffer(44 + pcm.length * 2);
  const view = new DataView(buffer);
  const tag = (at, text) => { for (let i = 0; i < text.length; i++) view.setUint8(at + i, text.charCodeAt(i)); };
  tag(0, 'RIFF'); view.setUint32(4, 36 + pcm.length * 2, true); tag(8, 'WAVE');
  tag(12, 'fmt '); view.setUint32(16, 16, true); view.setUint16(20, 1, true);
  view.setUint16(22, 1, true); view.setUint32(24, MIC.rate, true);
  view.setUint32(28, MIC.rate * 2, true); view.setUint16(32, 2, true); view.setUint16(34, 16, true);
  tag(36, 'data'); view.setUint32(40, pcm.length * 2, true);
  new Int16Array(buffer, 44).set(pcm);
  return new Blob([buffer], {type: 'audio/wav'});
}

async function sendPhrase(chunks, rate) {
  micBusy = true;
  micStatus('распознаю…');
  const started = performance.now();
  try {
    const test = micMode === 'test';
    const query = test ? '?dry_run=true'
      : currentSession ? `?session_id=${encodeURIComponent(currentSession)}` : '';
    const response = await fetch('/voice/listen' + query, {
      method: 'POST',
      headers: {'Content-Type': 'audio/wav'},
      body: toWav(chunks, rate),
    });
    const result = await response.json();
    if (!response.ok) throw new Error(result.detail || `ошибка ${response.status}`);
    const seconds = ((performance.now() - started) / 1000).toFixed(1);
    const heard = (test ? 'проверка: ' : '')
      + (result.transcript ? `«${result.transcript}»` : 'ничего не разобрал');
    const title = INTENT_TITLES[result.intent];
    $('mic-heard').textContent = title
      ? `${heard} → ${title}, ${seconds} с`
      : `${heard} — не команда, ${seconds} с`;
    micStatus('слушаю');
  } catch (err) {
    micStatus(`распознавание не удалось: ${err.message}`, 'error', 5000);
  } finally {
    micBusy = false;
  }
}

async function setMicMode(mode) {
  if (mode && !micRig) {
    try {
      micRig = await startMic();
    } catch (err) {
      micStatus(`микрофон недоступен: ${err.message}`, 'error', 5000);
      return;
    }
  }
  micMode = mode;
  if (!mode) stopMic();
  $('btn-mic').textContent = mode === 'live' ? 'Микрофон: вкл' : 'Микрофон: выкл';
  $('btn-mic').classList.toggle('primary', mode === 'live');
  $('btn-mic-test').textContent = mode === 'test' ? 'Проверка: вкл' : 'Проверить голос';
  $('btn-mic-test').classList.toggle('primary', mode === 'test');
  micStatus(mode ? 'слушаю' : 'выключен');
}

$('btn-mic').onclick = () => setMicMode(micMode === 'live' ? null : 'live');
$('btn-mic-test').onclick = () => setMicMode(micMode === 'test' ? null : 'test');

/* ---------- снимок сеанса ---------- */
function onSnapshot(s) {
  // Сменился сеанс — журнал предыдущего к нему отношения не имеет.
  // Сверяем по идентификатору, а не по нажатию кнопки: прогон могли запустить
  // с пульта, из другой вкладки или перезапуском движка.
  if (currentSession && s.session_id !== currentSession) $('journal').innerHTML = '';
  currentSession = s.session_id;

  snapshot = s;
  if (s.trainee_name && $('trainee').value !== s.trainee_name) $('trainee').value = s.trainee_name;

  $('btn-report').disabled = !s.session_id || s.state === 'idle';
  // Речь относится к занятию, а не к источнику наблюдений: без занятия
  // докладывать некому.
  const live = s.state === 'running' || s.state === 'paused';
  document.querySelectorAll('[data-voice]').forEach(b => { b.disabled = !live; });

  const pause = $('btn-pause');
  pause.textContent = s.state === 'paused' ? 'Продолжить' : 'Пауза';
  pause.classList.toggle('primary', s.state === 'paused');
  pause.disabled = !(s.state === 'running' || s.state === 'paused');

  const labels = {idle: 'не запущен', running: 'идёт тренировка', paused: 'пауза',
                  finished: 'завершён', aborted: 'остановлен'};
  const badge = $('state-badge');
  badge.textContent = labels[s.state] || s.state;
  badge.className = 'badge ' + s.state;

  $('blocked').innerHTML = s.blocked_message
    ? `<div class="alert"><b>Блокировка.</b> ${s.blocked_message}</div>` : '';

  renderSteps();
}

/* ---------- видеопоток ----------
   Ролик показывается только при проигрывании записи: у эмулятора картинки нет,
   и выдумывать её нельзя. Синхронизация — по положению записи на сервере,
   общая точка отсчёта у них одна: место кадра в съёмке. */
let currentReplay = null, replayTitle = null, currentRun = null;



/* ---------- разбор потока ----------
   Наблюдения приходят десятками в секунду, поэтому копим и выливаем в DOM
   кадром отрисовки: по строке на сообщение браузер не успевал бы, а лента
   всё равно читается только как поток. Смены состояния держим отдельным
   списком — иначе самое содержательное вымывалось бы сырыми наблюдениями. */
const FEED_MAX = 120;
let feedRows = [], feedQueued = false;

const feedTime = (iso) => {
  const d = new Date(iso);
  return d.toLocaleTimeString('ru-RU', {hour12: false}) +
    '.' + String(d.getMilliseconds()).padStart(3, '0');
};

function pushFeed(row) {
  feedRows.unshift(row);
  if (feedRows.length > FEED_MAX) feedRows.length = FEED_MAX;
  if (feedQueued) return;
  feedQueued = true;
  requestAnimationFrame(flushFeed);
}

function flushFeed() {
  feedQueued = false;
  const feed = $('feed');
  if (!feedRows.length) {
    feed.innerHTML = '<div class="empty">Наблюдений пока нет</div>';
    return;
  }
  const atTop = feed.scrollTop <= 4;
  feed.innerHTML = feedRows.map(r => `<div class="row ${r.cls}">
      <span class="t">${r.time}</span>
      <span class="var">${r.variable}</span>
      <span class="val">${r.value}</span>
      <span class="conf">${r.confidence}</span>
      <span class="status">${r.status}</span>
    </div>`).join('');
  if (atTop) feed.scrollTop = 0;
}

const observableTitle = (name) => scenario?.observables?.[name]?.title || name;

function valueTitle(name, value) {
  if (value === null || value === undefined) return '—';
  return scenario?.observables?.[name]?.values?.[value] || value;
}

/* Источник даёт по наблюдению на переменную десяток раз в секунду. Всё это
   в ленту не пускаем: читать её невозможно, а смены состояния — то, ради чего
   она и нужна, — вымывались бы за пару секунд. Оставляем по строке на
   переменную примерно раз в секунду; поток по-прежнему живой, но видно, что
   в нём происходит. */
const FEED_EVERY_MS = 800;
const lastShown = {};

function onObservation(o) {
  const now = Date.now();
  // Неразобранный кадр показываем всегда: это и есть событие.
  if (!o.unclear && now - (lastShown[o.variable] || 0) < FEED_EVERY_MS) return;
  lastShown[o.variable] = now;
  pushFeed({
    cls: o.unclear ? 'unclear' : '',
    time: feedTime(o.frame_ts),
    variable: observableTitle(o.variable),
    value: o.unclear ? '—' : valueTitle(o.variable, o.value),
    confidence: o.confidence?.toFixed(2) ?? '',
    status: o.unclear ? 'не разобрано' : '',
  });
}

function onStateChange(c) {
  const confirmed = c.quality === 'confirmed';
  pushFeed({
    cls: confirmed ? 'confirmed' : 'lost',
    time: feedTime(c.confirmed_ts),
    variable: observableTitle(c.variable),
    value: confirmed
      ? `${valueTitle(c.variable, c.previous_value)} → ${valueTitle(c.variable, c.value)}`
      : (c.quality === 'stale' ? 'нет данных' : 'не разобрано'),
    confidence: confirmed ? c.confidence.toFixed(2) : '',
    status: confirmed ? `подтверждено ${Math.round(c.agreement * 100)}%` : c.quality.toUpperCase(),
  });
}

/* Кадр и разбор занимают одно место: есть ролик — показываем его, нет —
   идёт лента. Поэтому у налива окно не пустует. */
function showVideo(on) {
  $('video').style.display = on ? '' : 'none';
  $('feed').style.display = on ? 'none' : '';
}

function hideVideo() {
  const video = $('video');
  currentReplay = null;
  currentRun = null;
  replayTitle = null;
  video.pause();
  video.removeAttribute('src');
  video.load();
  showVideo(false);
}

async function syncReplay() {
  let status = null;
  try { status = await api('/cv/status'); } catch { return; }
  const video = $('video');

  let busy = !!status.replay;
  if (!busy) {
    try { busy = (await api('/emulator/state')).mode === 'run'; } catch { /* нет эмулятора */ }
  }
  setSourcesBusy(busy);

  if (!status.replay) {
    // Запись отыграла. Не зацикливаем и не прячем: ролик останавливается сам,
    // последний кадр остаётся на экране — по нему удобно продолжать разговор.
    return;
  }

  if (status.replay !== currentReplay || status.replay_run !== currentRun) {
    currentReplay = status.replay;
    currentRun = status.replay_run;
    replayTitle = status.replay_title || null;
    video.loop = false;
    video.src = `/cv/logs/${status.replay}/video`;
    video.currentTime = 0;
    showVideo(true);
  }

  if (video.ended) return;

  if (status.replay_holding) {
    // Съёмка ждёт реакции системы — кадр замирает вместе с ней.
    if (!video.paused) video.pause();
    return;
  }

  const target = status.replay_position_sec || 0;
  if (Number.isFinite(video.duration) && target < video.duration - 0.3
      && Math.abs(video.currentTime - target) > 0.6) {
    video.currentTime = target;
  }
  if (video.paused) video.play().catch(() => {});
}

async function pollCamera() {
  await syncReplay();
}

/* Пока идёт запись или прогон, соседние запускать нельзя: второй источник
   встанет поверх первого, и вместо демонстрации получится каша. */
function setSourcesBusy(busy) {
  document.querySelectorAll('#cv-logs button, #runs button')
    .forEach(b => { b.disabled = busy; });
}

/* ---------- записи реальной съёмки ----------
   Проигрываются через тот же приёмник, что и живое подключение к CV-модулю,
   поэтому для стенда это не отдельный режим, а обычный источник наблюдений. */
/* Чем начинается занятие — свойство сюжета. Там, где источник наблюдений
   это запись, занятие начинает сама запись: отдельная кнопка «Старт» только
   сбивала бы с толку, ведь нажать её надо было бы до показа и незачем. */
function applyStartControl(hasRecordings) {
  $('btn-start').style.display = hasRecordings ? 'none' : '';
}

async function loadManualControl() {
  // Пульт нужен только при работе от эмулятора: на записи реальной съёмки
  // действия выполняет человек в кадре, а не инструктор тумблером.
  let manual = true;
  try { manual = (await api('/emulator/state')).enabled !== false; } catch { manual = false; }
  $('btn-panel').style.display = manual ? '' : 'none';
}

async function loadCvLogs() {
  let logs = [];
  try { logs = await api('/cv/logs'); } catch { /* приёмник может быть выключен */ }
  // При живом приёме занятие запускается кнопкой, а записи остаются запасным
  // путём: иначе начать занятие можно было бы только проигрыванием записи.
  let live = false;
  try { live = (await api('/cv/status')).enabled === true; } catch { /* приёмник выключен */ }
  $('cv-logs-wrap').style.display = logs.length ? '' : 'none';
  applyStartControl(logs.length > 0 && !live);
  if (!logs.length) {
    // Список прошлого сюжета иначе остался бы в разметке скрытым.
    $('cv-logs').innerHTML = '';
    hideVideo();
    return;
  }

  $('cv-logs').innerHTML = logs.map(entry => `
    <button data-log="${entry.id}">
      ${entry.title}
      <span class="d">${entry.description || ''} · ${entry.duration_sec} с · событий ${entry.events}</span>
    </button>`).join('');

  $('cv-logs').querySelectorAll('button').forEach(button => {
    button.onclick = async () => {
      if (snapshot?.state !== 'running') {
        await post('/session/start',
          {mode: DEMO_MODE, trainee_name: $('trainee').value || null});
      }
      await post(`/cv/logs/${button.dataset.log}/play`);
    };
  });
}

/* ---------- сюжеты ---------- */
async function loadScenarios() {
  const list = await api('/scenarios');
  $('scenario-pick').innerHTML = list.map(s =>
    `<option value="${s.id}" ${s.active ? 'selected' : ''}>${s.scenario_code} — ${s.title}</option>`
  ).join('');
}

$('scenario-pick').onchange = async (e) => {
  const select = e.target;
  select.disabled = true;
  try {
    await post(`/scenarios/${select.value}`);
    $('journal').innerHTML = '';
    lastEntryText = null;
    stopSpeaking();
    await loadScenario();
    await loadRuns();
    await loadCvLogs();
    // Источник наблюдений — свойство сюжета, значит и пульт появляется
    // или исчезает вместе с ним.
    await loadManualControl();
  } finally {
    select.disabled = false;
  }
};


/* ---------- подключение ---------- */
function connect() {
  const protocol = location.protocol === 'https:' ? 'wss' : 'ws';
  const socket = new WebSocket(`${protocol}://${location.host}/ws`);
  socket.onmessage = (message) => {
    const {type, payload, replay} = JSON.parse(message.data);
    if (type === 'snapshot') onSnapshot(payload);
    else if (type === 'verdict') onVerdict(payload);
    else if (type === 'spoken') onSpoken(payload, replay === true);
    else if (type === 'observation') onObservation(payload);
    else if (type === 'state') onStateChange(payload);
  };
  socket.onclose = () => setTimeout(connect, 1500);
}

/* ---------- события ---------- */
$('btn-start').onclick = () => post('/session/start',
  {mode: DEMO_MODE, trainee_name: $('trainee').value || null});
$('btn-pause').onclick = () => {
  if (snapshot?.state === 'paused') return post('/session/resume');
  stopSpeaking();
  return post('/session/pause');
};
$('btn-stop').onclick = () => { stopSpeaking(); return post('/session/stop'); };
$('btn-reset').onclick = async () => {
  stopSpeaking();
  hideVideo();
  $('journal').innerHTML = '';
  await post('/emulator/reset');
  await post('/session/reset');
};
// Отчёт собирается на сервере и может занять секунды: разбор занятия пишет
// языковая модель. Поэтому скачиваем через fetch и показываем состояние на
// кнопке, а не уводим браузер по ссылке.
$('btn-report').onclick = async (e) => {
  const button = e.target;
  const session = snapshot?.session_id;
  if (!session) return;

  const label = button.textContent;
  button.disabled = true;
  button.textContent = 'Готовлю…';
  try {
    const response = await fetch(`/api/sessions/${session}/report.docx`);
    if (!response.ok) throw new Error(`HTTP ${response.status}`);

    const blob = await response.blob();
    const match = /filename\*=UTF-8''([^;]+)/.exec(
      response.headers.get('Content-Disposition') || '');
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = match ? decodeURIComponent(match[1]) : 'otchet.docx';
    link.click();
    URL.revokeObjectURL(link.href);
  } catch (error) {
    button.textContent = 'Не получилось';
    setTimeout(() => { button.textContent = label; }, 2500);
    return;
  } finally {
    button.disabled = false;
    if (button.textContent === 'Готовлю…') button.textContent = label;
  }
};

$('btn-panel').onclick = () => window.open('/panel', 'panel',
  'width=460,height=820,menubar=no,toolbar=no,location=no');
$('btn-mute').onclick = (e) => {
  muted = !muted;
  e.target.textContent = muted ? 'Звук: выкл' : 'Звук: вкл';
  if (muted) stopSpeaking();
};
document.querySelectorAll('[data-voice]').forEach(button => {
  button.onclick = () => post('/emulator/voice', {intent: button.dataset.voice});
});
document.querySelectorAll('[data-stream]').forEach(button => {
  button.onclick = () => post('/emulator/stream', {
    state: button.dataset.stream,
    reason: button.dataset.stream === 'lost' ? 'обрыв соединения с нагрудной камерой' : null,
  });
});
document.querySelectorAll('[data-voice]').forEach(button => {
  button.onclick = () => post('/emulator/voice', {intent: button.dataset.voice});
});

(async () => {
  await loadScenarios();
  await loadScenario();
  await loadRuns();
  await loadCvLogs();
  await loadManualControl();
  connect();
  pollCamera();
  setInterval(pollCamera, 600);
  try {
    const voice = await api('/voice/state');
    browserSpeech = voice.browser_speech;
    setupMic(voice.server_stt);
  } catch {
    // Голос может подниматься дольше страницы.
    micStatus('голосовой сервис не ответил — обновите страницу');
  }
})();
</script>
</body>
</html>
