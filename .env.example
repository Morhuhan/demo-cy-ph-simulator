# Переменные окружения. Скопировать в .env и поправить под площадку.
#
# Всё содержательное живёт в configs/app.yaml — здесь только то, что зависит
# от способа развёртывания, а не от сценария.

# Шина. Задана — используется Redis Streams (docker-сборка).
# Пустая или отсутствует — шина в памяти (python run_local.py).
REDIS_URL=redis://redis:6379/0

# Порт интерфейса инструктора на хосте.
UI_PORT=8080

# Уровень журналирования: debug | info | warning | error
LOG_LEVEL=info

# Путь к конфигурации, если нужен нестандартный.
KFT_CONFIG=configs/app.yaml

# Строка подключения к БД для Alembic, если отличается от configs/app.yaml.
# Переход на PostgreSQL (п. 6.4 вопросника) — это смена только этой строки:
# DATABASE_URL=postgresql+asyncpg://kft:kft@postgres:5432/kft01
# DATABASE_URL=sqlite+aiosqlite:///data/kft01.sqlite3

# Ключ к языковой модели для разбора занятия. Без него разбор формируется
# по шаблону — это штатный режим, а не деградация.
AI_API_KEY=

# Ключ ИИ-наставника выставочного экрана /expo (gptunnel). Без него экран
# отвечает на вопросы по тексту СОП.
AI_MENTOR_KEY=

# Токен Hugging Face для распознавания голосовых команд обучаемого (stt.engine:
# hf). Фраза уходит на серверы HF. Без токена стенд работает, а команды
# остаются кнопками инструктора. Достаточно мелкого токена с одним правом —
# «Make calls to Inference Providers».
HF_TOKEN=
