{
  "$defs": {
    "Mode": {
      "description": "Три режима по п. 5.1–5.3 ТЗ.",
      "enum": [
        "training",
        "testing",
        "demo"
      ],
      "title": "Mode",
      "type": "string"
    },
    "SessionState": {
      "enum": [
        "idle",
        "running",
        "paused",
        "finished",
        "aborted"
      ],
      "title": "SessionState",
      "type": "string"
    },
    "StepStatus": {
      "enum": [
        "pending",
        "active",
        "done",
        "failed",
        "skipped"
      ],
      "title": "StepStatus",
      "type": "string"
    },
    "StepView": {
      "additionalProperties": false,
      "description": "Состояние одного шага для отображения инструктору.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "critical": {
          "default": false,
          "title": "Critical",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/StepStatus",
          "default": "pending"
        },
        "last_verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerdictKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "started_ts": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started Ts"
        },
        "finished_ts": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished Ts"
        },
        "deadline_ts": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Когда сработает сторожевой таймер шага",
          "title": "Deadline Ts"
        }
      },
      "required": [
        "id",
        "index",
        "title"
      ],
      "title": "StepView",
      "type": "object"
    },
    "VerdictKind": {
      "enum": [
        "MATCH",
        "MISMATCH",
        "UNCLEAR",
        "TIMEOUT"
      ],
      "title": "VerdictKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Полное состояние сеанса тренировки.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "description": "Версия контракта. Мажорная часть — признак совместимости.",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "description": "Уникальный идентификатор сообщения",
      "title": "Event Id",
      "type": "string"
    },
    "ts": {
      "description": "Момент формирования сообщения, UTC",
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "sop_id": {
      "title": "Sop Id",
      "type": "string"
    },
    "sop_title": {
      "title": "Sop Title",
      "type": "string"
    },
    "scenario_code": {
      "default": "",
      "description": "Код сценария занятия. Едет со снимком: сценарий переключается на ходу.",
      "title": "Scenario Code",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "state": {
      "$ref": "#/$defs/SessionState"
    },
    "trainee_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trainee Name"
    },
    "current_step_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Step Id"
    },
    "current_step_index": {
      "default": 0,
      "title": "Current Step Index",
      "type": "integer"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/StepView"
      },
      "title": "Steps",
      "type": "array"
    },
    "errors_count": {
      "default": 0,
      "title": "Errors Count",
      "type": "integer"
    },
    "failed_step_ids": {
      "items": {
        "type": "string"
      },
      "title": "Failed Step Ids",
      "type": "array"
    },
    "blocked_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Текст действующей критической блокировки. Заполнен, пока нарушение не исправлено: сценарий не продвигается, пока здесь что-то есть.",
      "title": "Blocked Message"
    },
    "observed_state": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": "Текущее подтверждённое состояние оборудования, как его видит движок",
      "title": "Observed State",
      "type": "object"
    },
    "stream_online": {
      "default": true,
      "title": "Stream Online",
      "type": "boolean"
    },
    "started_ts": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started Ts"
    },
    "finished_ts": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished Ts"
    }
  },
  "required": [
    "session_id",
    "sop_id",
    "sop_title",
    "mode",
    "state"
  ],
  "title": "session-snapshot",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
